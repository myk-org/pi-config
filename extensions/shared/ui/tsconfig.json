{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/lib/utils": [
        "../../pidiff/pidiff-ui/src/lib/utils.ts",
        "../../pidash/pidash-ui/src/lib/utils.ts"
      ]
    }
  },
  "include": ["*.tsx", "*.ts"]
}
