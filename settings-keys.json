{
  "dco": {
    "type": "bool",
    "env": "PI_DCO",
    "default": false,
    "group": "Git"
  },
  "commit_trailer": {
    "type": "bool_or_string",
    "env": "PI_COMMIT_TRAILER",
    "default": false,
    "group": "Git"
  },
  "use_worktrees": {
    "type": "bool",
    "env": "PI_USE_WORKTREES",
    "default": false,
    "group": "Git"
  },
  "allow_push_to_protected_branches": {
    "type": "bool",
    "env": "PI_ALLOW_PUSH_TO_PROTECTED_BRANCHES",
    "default": false,
    "group": "Git"
  },
  "comment_signature": {
    "type": "bool",
    "default": false,
    "group": "Git"
  },
  "review_loop_enforcement": {
    "type": "bool",
    "env": "PI_REVIEW_LOOP_ENFORCEMENT",
    "default": false,
    "group": "Review"
  },
  "review_loop_max_cycles": {
    "type": "int",
    "env": "PI_REVIEW_LOOP_MAX_CYCLES",
    "default": 3,
    "min": 1,
    "max": 10,
    "strict_digits": true,
    "group": "Review"
  },
  "dream_interval_hours": {
    "type": "number",
    "env": "PI_DREAM_INTERVAL_HOURS",
    "default": 3,
    "group": "Memory"
  },
  "orchestrator_edit_write_block": {
    "type": "bool",
    "default": false,
    "group": "Enforcement"
  },
  "pidash_enable": {
    "type": "bool_enable",
    "env": "PI_PIDASH_ENABLE",
    "default": true,
    "group": "Dashboard"
  },
  "pidiff_enable": {
    "type": "bool_enable",
    "env": "PI_PIDIFF_ENABLE",
    "default": true,
    "group": "Dashboard"
  },
  "pidash_port": {
    "type": "port",
    "env": "PI_PIDASH_PORT",
    "default": 19190,
    "min": 1,
    "group": "Dashboard"
  },
  "image_model": {
    "type": "string",
    "env": "PI_IMAGE_MODEL",
    "default": "",
    "group": "Provider"
  },
  "internal_operations_provider": {
    "type": "string",
    "env": "PI_INTERNAL_OPERATIONS_PROVIDER",
    "default": "",
    "group": "Provider"
  },
  "internal_operations_model": {
    "type": "string",
    "env": "PI_INTERNAL_OPERATIONS_MODEL",
    "default": "",
    "group": "Provider"
  },
  "acpx_agents": {
    "type": "agent_list",
    "env": "ACPX_AGENTS",
    "default": [],
    "per_key_resolution": true,
    "group": "Provider"
  },
  "cli_agents": {
    "type": "agent_list",
    "env": "CLI_AGENTS",
    "default": [],
    "per_key_resolution": true,
    "group": "Provider"
  },
  "agent_provider": {
    "type": "string",
    "default": "",
    "group": "Provider"
  },
  "agent_model": {
    "type": "string",
    "default": "",
    "group": "Provider"
  },
  "agent_overrides": {
    "type": "agent_overrides",
    "default": {},
    "group": "Provider"
  },
  "vertex_claude_1m": {
    "type": "bool",
    "env": "VERTEX_CLAUDE_1M",
    "default": false,
    "group": "Provider"
  },
  "sidecar_log_level": {
    "type": "string",
    "env": "PI_SIDECAR_LOG_LEVEL",
    "default": "info",
    "group": "Logging"
  },
  "enforcement_allowed_commands": {
    "type": "string",
    "env": "PI_ENFORCEMENT_ALLOWED_COMMANDS",
    "default": "",
    "group": "Enforcement"
  },
  "coms_max_hops": {
    "type": "int",
    "env": "PI_COMS_MAX_HOPS",
    "default": 5,
    "min": 1,
    "max": 50,
    "group": "Coms"
  },
  "coms_timeout_ms": {
    "type": "int",
    "env": "PI_COMS_TIMEOUT_MS",
    "default": 1800000,
    "min": 1000,
    "group": "Coms"
  },
  "coms_dir": {
    "type": "string",
    "env": "PI_COMS_DIR",
    "default": "",
    "group": "Coms"
  },
  "coms_task_heartbeat_ms": {
    "type": "int",
    "env": "PI_COMS_TASK_HEARTBEAT_MS",
    "default": 300000,
    "min": 10000,
    "group": "Coms"
  },
  "log_pitasks": {
    "type": "string",
    "env": "PI_LOG_PITASKS",
    "default": "info",
    "enum": ["off", "debug", "info", "warn", "error"],
    "group": "Logging"
  },
  "log_pidash": {
    "type": "string",
