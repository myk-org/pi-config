{
  "name": "pi-orchestrator-config",
  "version": "4.1.5",
  "description": "Orchestrator pattern for pi: specialist subagents, enforcement, code review loop, workflow commands",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "workspaces": ["packages/pi-sidecar"],
  "files": [
    "extensions/acpx-provider/",
    "extensions/cli-provider/",
    "extensions/providers/",
    "extensions/shared/",
    "extensions/orchestrator/",
    "extensions/coms/",
    "extensions/image-gen/",
    "extensions/pidash/*.ts",
    "extensions/pidiff/*.ts",
    "agents/",
    "rules/",
    "prompts/",
    "templates/",
    "skills/"
  ],
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "acpx": ">=0.12.0 <1",
    "chokidar": "^5.0.0",
    "discord.js": "^14.0.0",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0"
  },
  "allowScripts": {
    "onnxruntime-node": true,
    "sharp": true,
    "protobufjs": true,
    "esbuild": true
  },
  "overrides": {
    "undici": ">=6.27.0 <9.0.0",
    "adm-zip": "^0.6.0",
    "protobufjs": "7.6.5",
    "sharp": "0.35.3"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "prompts": [
      "./prompts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
