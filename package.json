{
  "name": "pi-orchestrator-config",
  "version": "4.7.0",
  "description": "Orchestrator pattern for pi: specialist subagents, enforcement, code review loop, workflow commands",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/pi-sidecar",
    "packages/pi-vertex-claude",
    "extensions/pidiff/pidiff-ui"
  ],
  "files": [
    "extensions/acpx-provider/",
    "extensions/cli-provider/",
    "extensions/providers/",
    "extensions/openai-compatible-discovery/",
    "extensions/shared/",
    "extensions/orchestrator/",
    "extensions/coms/",
    "extensions/image-gen/",
    "extensions/pidash/*.ts",
    "extensions/pidash/pidash-ui/src/",
    "extensions/pidash/pidash-ui/index.html",
    "extensions/pidash/pidash-ui/package.json",
    "extensions/pidash/pidash-ui/package-lock.json",
    "extensions/pidash/pidash-ui/tsconfig.json",
    "extensions/pidash/pidash-ui/vite.config.ts",
    "extensions/pidash/pidash-ui/components.json",
    "extensions/pidash/pidash-ui/dist/",
    "extensions/pidiff/*.ts",
    "extensions/pidiff/pidiff-ui/src/",
    "extensions/pidiff/pidiff-ui/index.html",
    "extensions/pidiff/pidiff-ui/package.json",
    "extensions/pidiff/pidiff-ui/package-lock.json",
    "extensions/pidiff/pidiff-ui/tsconfig.json",
    "extensions/pidiff/pidiff-ui/vite.config.ts",
    "extensions/pidiff/pidiff-ui/dist/",
    "extensions/pitasks/",
    "scripts/pidash-server.ts",
    "scripts/pidash-session-state.ts",
    "scripts/pidiff-server.ts",
    "scripts/pidiff-git-ignore.ts",
    "scripts/daemon-shared.ts",
    "scripts/serve-ui.ts",
    "scripts/pidash-discord.ts",
    "scripts/httpd.py",
    "scripts/symlink-cli-specialists.sh",
    "scripts/build-extension-uis.sh",
    "scripts/graft-allow-scripts.mjs",
    "agents/",
    "rules/",
    "prompts/",
    "templates/",
    "skills/",
    "settings-keys.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "acpx": ">=0.12.0 <1",
    "chokidar": "^5.0.0",
    "discord.js": "^14.0.0",
    "strip-json-comments": "^5.0.3",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.99.1",
    "@earendil-works/pi-ai": "^0.99.1",
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@earendil-works/pi-tui": "^0.99.1",
    "@types/node": "^22.20.1",
    "tsx": "^4.0.0"
  },
  "scripts": {
    "build:extension-uis": "bash scripts/build-extension-uis.sh",
    "prepack": "npm run build:extension-uis"
  },
  "allowScripts": {
    "onnxruntime-node": true,
    "sharp": true,
    "protobufjs": true,
    "esbuild": true
  },
  "overrides": {
    "undici": ">=6.27.0 <9.0.0",
    "protobufjs": "7.6.5"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "prompts": [
      "./prompts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "type": "module"
}
